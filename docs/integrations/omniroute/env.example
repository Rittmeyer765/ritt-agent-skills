# OmniRoute env — EXAMPLE, NO REAL SECRETS. Reconcile names with the pinned release's .env.selfhost.example.
OMNIROUTE_VERSION=3.8.51

# Required secrets — generate each with: openssl rand -hex 32
JWT_SECRET=<GENERATE_32_BYTE_HEX>
API_KEY_SECRET=<GENERATE_32_BYTE_HEX>
STORAGE_ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX>   # REQUIRED: unset => possible plaintext credential storage

# Network: loopback only
HOST=127.0.0.1
PORT=20128

# Harden: keep every extra surface OFF by default
ENABLE_MCP=false
ENABLE_A2A=false
ENABLE_WEBHOOKS=false
ENABLE_CLOUD_SYNC=false
ENABLE_MITM=false
PROMPT_LOGGING=false

# Only providers you explicitly permit
PROVIDER_ALLOWLIST=<comma-separated-providers>

# Do NOT enable OmniRoute's own concise/ponytail-style output; local Ponytail plugin already covers it
OMNIROUTE_OUTPUT_STYLE=off
